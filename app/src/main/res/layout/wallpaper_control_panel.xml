<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC1A1A2E">

    <!-- 标题行：壁纸名称 + 关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_wallpaper_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:textStyle="bold"
            android:text="壁纸名称" />

        <Button
            android:id="@+id/btn_close_panel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_settings_button"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <!-- 手势旋转显示 + 单独还原（仅手势壁纸显示） -->
    <LinearLayout
        android:id="@+id/layout_rotation_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="手势旋转"
            android:textSize="12sp"
            android:textColor="#CCFFFFFF" />

        <TextView
            android:id="@+id/tv_rotation_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="X 0°  Y 0°"
            android:textSize="12sp"
            android:textColor="#FF80CBC4" />

        <Button
            android:id="@+id/btn_reset_rotation"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:background="@drawable/bg_settings_button"
            android:text="还原旋转"
            android:textSize="11sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_params"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="16dp">

        <LinearLayout
            android:id="@+id/layout_params_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/btn_reset_params"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:layout_marginRight="12dp"
        android:layout_marginTop="4dp"
        android:text="重置默认"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_settings_button"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:minWidth="0dp" />

</LinearLayout>
