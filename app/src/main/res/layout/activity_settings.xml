<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Clock Settings Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clock_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Clock Style -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clock_style"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/spinner_clock_style"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

        <!-- Font Size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/font_size"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_font_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80px"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seekbar_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Position X -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/position_x"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_pos_x_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seekbar_pos_x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Position Y -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/position_y"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_pos_y_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seekbar_pos_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Show seconds / date -->
        <CheckBox
            android:id="@+id/check_show_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_seconds"
            android:textColor="#CCCCCC" />
        <CheckBox
            android:id="@+id/check_show_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_date"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <!-- Anti Burn-in Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/anti_burn_in_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/check_anti_burn_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/anti_burn_in"
            android:textColor="#CCCCCC" />
        <CheckBox
            android:id="@+id/check_pixel_shift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pixel_shift"
            android:textColor="#CCCCCC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/burn_in_interval"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_burn_in_interval_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30s"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seekbar_burn_in_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Background Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bg_mode"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/spinner_bg_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_bg_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_color"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btn_bg_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_image"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tv_bg_image_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:singleLine="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btn_bg_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_video"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tv_bg_video_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:singleLine="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- DLNA Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dlna_settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_name"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/edit_device_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_dlna_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_apply_dlna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
