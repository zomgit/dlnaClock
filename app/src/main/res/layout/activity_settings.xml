<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:clipToPadding="false">

        <!-- ============ Card 1: Clock Settings ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <!-- Title row (clickable) -->
            <LinearLayout
                android:id="@+id/title_clock_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/clock_settings" />
                <ImageView
                    android:id="@+id/arrow_clock_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_expand_arrow" />
            </LinearLayout>

            <!-- Collapsible content -->
            <LinearLayout
                android:id="@+id/content_clock_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <!-- Clock Style -->
                <TextView
                    style="@style/Settings.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_style" />
                <Spinner
                    android:id="@+id/spinner_clock_style"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_settings_spinner"
                    android:layout_marginBottom="@dimen/item_spacing" />

                <!-- Clock Format (wrapped for visibility control, visible for digital only) -->
                <LinearLayout
                    android:id="@+id/layout_clock_format"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/item_spacing">

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clock_format" />
                    <Spinner
                        android:id="@+id/spinner_clock_format"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_spinner"
                        android:layout_marginBottom="@dimen/label_spacing" />
                    <EditText
                        android:id="@+id/edit_clock_format"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/format_hint"
                        android:background="@drawable/bg_settings_edittext"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:singleLine="true"
                        android:layout_marginBottom="@dimen/item_spacing"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Font Size -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/font_size" />
                    <TextView
                        android:id="@+id/tv_font_size_value"
                        style="@style/Settings.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_value_badge"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="12%" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekbar_font_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_spacing" />

                <!-- Position X -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/position_x" />
                    <TextView
                        android:id="@+id/tv_pos_x_value"
                        style="@style/Settings.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_value_badge"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="50%" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekbar_pos_x"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_spacing" />

                <!-- Position Y -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/position_y" />
                    <TextView
                        android:id="@+id/tv_pos_y_value"
                        style="@style/Settings.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_value_badge"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="50%" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekbar_pos_y"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_spacing" />

                <!-- Digital Clock Font Settings -->
                <LinearLayout
                    android:id="@+id/layout_digital_font"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/item_spacing">

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/number_font" />
                    <Spinner
                        android:id="@+id/spinner_number_font"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_spinner"
                        android:layout_marginBottom="@dimen/item_spacing" />

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/english_font" />
                    <Spinner
                        android:id="@+id/spinner_english_font"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_spinner"
                        android:layout_marginBottom="@dimen/item_spacing" />

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chinese_font" />
                    <Spinner
                        android:id="@+id/spinner_chinese_font"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_spinner"
                        android:layout_marginBottom="@dimen/item_spacing" />
                </LinearLayout>

                <!-- Minimal Clock Settings -->
                <LinearLayout
                    android:id="@+id/layout_minimal_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/item_spacing"
                    android:visibility="gone">

                    <TextView
                        style="@style/Settings.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/item_spacing"
                        android:text="@string/minimal_clock_settings" />

                    <LinearLayout
                        android:id="@+id/layout_profile_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/layout_row_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Clock Color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/clock_color" />
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:padding="2dp"
                        android:layout_marginStart="8dp">
                        <Button
                            android:id="@+id/btn_clock_color"
                            android:layout_width="48dp"
                            android:layout_height="48dp" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tv_clock_color_value"
                        style="@style/Settings.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_value_badge"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="#FFFFFF"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Card 2: Anti Burn-in ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:id="@+id/title_anti_burn_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/anti_burn_in_settings" />
                <ImageView
                    android:id="@+id/arrow_anti_burn_in"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_expand_arrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_anti_burn_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/check_anti_burn_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/anti_burn_in"
                    android:textColor="@color/text_secondary" />
                <CheckBox
                    android:id="@+id/check_pixel_shift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pixel_shift"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="@dimen/item_spacing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/burn_in_interval" />
                    <TextView
                        android:id="@+id/tv_burn_in_interval_value"
                        style="@style/Settings.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_value_badge"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="30s" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekbar_burn_in_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Card 3: Background ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:id="@+id/title_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/background_settings" />
                <ImageView
                    android:id="@+id/arrow_background"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_expand_arrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/Settings.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_mode" />
                <RadioGroup
                    android:id="@+id/radio_bg_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/item_spacing">
                    <RadioButton
                        android:id="@+id/radio_bg_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="纯色"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <RadioButton
                        android:id="@+id/radio_bg_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="图片"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                    <RadioButton
                        android:id="@+id/radio_bg_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="视频"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                    <RadioButton
                        android:id="@+id/radio_bg_wallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="动态"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                    <RadioButton
                        android:id="@+id/radio_bg_custom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自定义"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                </RadioGroup>

                <!-- 澹佺焊鏍峰紡閫夋嫨锛堝姩鎬佸绾告ā寮忔椂鏄剧ず锛?-->
                <TextView
                    android:id="@+id/tv_wallpaper_type_label"
                    style="@style/Settings.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpaper_type"
                    android:visibility="gone" />
                <Spinner
                    android:id="@+id/spinner_wallpaper_type"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_settings_spinner"
                    android:layout_marginBottom="@dimen/item_spacing"
                    android:visibility="gone" />

                <!-- 壁纸参数动态区域（仅在动态壁纸模式下显示） -->
                <LinearLayout
                    android:id="@+id/layout_wallpaper_params"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/item_spacing" />

                <!-- Lua 壁纸管理区域（仅在自定义模式下显示） -->
                <LinearLayout
                    android:id="@+id/layout_lua_wallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/item_spacing">

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lua 壁纸" />
                    <Spinner
                        android:id="@+id/spinner_lua_wallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_spinner"
                        android:layout_marginBottom="@dimen/label_spacing" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/item_spacing">
                        <Button
                            android:id="@+id/btn_lua_new"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="新增"
                            android:textSize="13sp"
                            android:background="@drawable/bg_settings_button"
                            android:textColor="@color/text_primary"
                            android:layout_marginEnd="4dp" />
                        <Button
                            android:id="@+id/btn_lua_edit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="编辑"
                            android:textSize="13sp"
                            android:background="@drawable/bg_settings_button"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp" />
                        <Button
                            android:id="@+id/btn_lua_delete"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="删除"
                            android:textSize="13sp"
                            android:background="@drawable/bg_settings_button"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp" />
                        <Button
                            android:id="@+id/btn_lua_copy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="复制"
                            android:textSize="13sp"
                            android:background="@drawable/bg_settings_button"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Color row (mode==0) -->
                <LinearLayout
                    android:id="@+id/layout_bg_color_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    <Button
                        android:id="@+id/btn_bg_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_color"
                        android:background="@drawable/bg_settings_button"
                        android:textColor="@color/text_primary"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />
                </LinearLayout>

                <!-- Image row (mode==1) -->
                <LinearLayout
                    android:id="@+id/layout_bg_image_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <Button
                            android:id="@+id/btn_bg_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_image"
                            android:background="@drawable/bg_settings_button"
                            android:textColor="@color/text_primary"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp" />
                        <TextView
                            android:id="@+id/tv_bg_image_name"
                            style="@style/Settings.Hint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <!-- Image fit mode -->
                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_spacing"
                        android:text="@string/bg_image_fit" />
                    <Spinner
                        android:id="@+id/spinner_bg_image_fit"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_spinner"
                        android:layout_marginBottom="@dimen/item_spacing" />
                </LinearLayout>

                <!-- Video row (mode==2) -->
                <LinearLayout
                    android:id="@+id/layout_bg_video_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    <Button
                        android:id="@+id/btn_bg_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_video"
                        android:background="@drawable/bg_settings_button"
                        android:textColor="@color/text_primary"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />
                    <TextView
                        android:id="@+id/tv_bg_video_name"
                        style="@style/Settings.Hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Card 4: OSD 叠加层设置 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:id="@+id/title_osd_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="投屏 OSD 叠加层" />
                <ImageView
                    android:id="@+id/arrow_osd_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_expand_arrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_osd_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/check_osd_time_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示当前时间 OSD"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="@dimen/item_spacing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="时间文字大小" />
                    <TextView
                        android:id="@+id/tv_osd_font_size_value"
                        style="@style/Settings.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_value_badge"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="120" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekbar_osd_font_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_spacing" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Card 5: DLNA ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:id="@+id/title_dlna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/dlna_settings" />
                <ImageView
                    android:id="@+id/arrow_dlna"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_expand_arrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_dlna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/check_dlna_enable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_enable"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="@dimen/label_spacing" />

                <TextView
                    android:id="@+id/tv_dlna_disabled_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DLNA 投屏功能未启用，其他设备无法发现本机"
                    android:textColor="@color/warning_text"
                    android:textSize="13sp"
                    android:background="@drawable/bg_warning_banner"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layout_dlna_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_name" />
                    <EditText
                        android:id="@+id/edit_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_edittext"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:layout_marginBottom="@dimen/item_spacing" />

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_player" />
                    <Spinner
                        android:id="@+id/spinner_video_player"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_spinner"
                        android:layout_marginBottom="@dimen/item_spacing" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_dlna_status"
                    style="@style/Settings.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Card 6: AirPlay ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:id="@+id/title_airplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/airplay_settings" />
                <ImageView
                    android:id="@+id/arrow_airplay"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_expand_arrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_airplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/check_airplay_enable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/airplay_enable"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layout_airplay_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Settings.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/airplay_device_name" />
                    <EditText
                        android:id="@+id/edit_airplay_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_edittext"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:layout_marginBottom="@dimen/item_spacing" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_airplay_status"
                    style="@style/Settings.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Card: 高级/调试 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:id="@+id/title_advanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="\u9ad8\u7ea7\u8bbe\u7f6e" />
                <ImageView
                    android:id="@+id/arrow_advanced"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_expand_arrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_advanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/check_debug_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="\u8c03\u8bd5\u65e5\u5fd7\u8f93\u51fa"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    style="@style/Settings.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="\u5f00\u542f\u540e\u8f93\u51fa VERBOSE/DEBUG \u7ea7\u522b\u65e5\u5fd7\uff0c\u53ef\u901a\u8fc7 adb logcat \u67e5\u770b"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
