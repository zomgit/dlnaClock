<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.dlnaclock.media.AspectRatioSurfaceView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.dlnaclock.media.OsdOverlayView
        android:id="@+id/osd_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#B3000000"
        android:padding="8dp"
        android:visibility="gone">

        <!-- 进度条行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="48dp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp" />

            <TextView
                android:id="@+id/text_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="48dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btn_stop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_stop"
                android:background="#80000000"
                android:contentDescription="停止"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_play"
                android:background="#80000000"
                android:contentDescription="播放/暂停"
                android:scaleType="centerInside"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角工具按钮（解码切换 + 信息） -->
    <LinearLayout
        android:id="@+id/top_right_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_decoder_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#80000000"
            android:text="硬解"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_media_info"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="#80000000"
            android:text="信息"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

    </LinearLayout>

</FrameLayout>
