<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/control_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/control_stroke" />
            <corners android:radius="@dimen/control_corner" />
            <padding
                android:left="12dp"
                android:top="0dp"
                android:right="24dp"
                android:bottom="0dp" />
        </shape>
    </item>
</layer-list>
